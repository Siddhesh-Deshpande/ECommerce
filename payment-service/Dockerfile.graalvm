# Compile the Spring Boot service to a native executable.
FROM ghcr.io/graalvm/native-image-community:21 AS build
COPY --from=maven:3.9-eclipse-temurin-21 /usr/share/maven /usr/share/maven
ENV MAVEN_HOME=/usr/share/maven
ENV PATH="${MAVEN_HOME}/bin:${PATH}"
WORKDIR /workspace
COPY . .
RUN mvn -B -Pnative,graalvm-build -DskipTests -pl payment-service -am package

# GraalVM native-image-community uses glibc; use a small compatible runtime.
FROM debian:bookworm-slim
WORKDIR /app
RUN useradd --system --uid 10001 app
COPY --from=build --chown=10001:10001 /workspace/payment-service/target/payment-service /app/application
USER 10001:10001
ENTRYPOINT ["/app/application"]
